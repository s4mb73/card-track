# ── Supabase ────────────────────────────────────────────
SUPABASE_URL=https://yourproject.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...   # NEVER commit this; service role bypasses RLS

# ── Anthropic (fallback classifier only; normal Topps mail is parsed deterministically) ──
ANTHROPIC_API_KEY=sk-ant-...
# Optional — concurrent Claude calls when the parser falls back (default 4)
CLAUDE_CONCURRENCY=4

# ── Discord auto-notify (checker.js → notify-discord Edge Function) ──
# On by default; set to false to stop the checker auto-posting status changes.
AUTO_NOTIFY=true
# Optional override; defaults to ${SUPABASE_URL}/functions/v1
# SUPABASE_FUNCTIONS_URL=https://yourproject.supabase.co/functions/v1

# ── Railway service (server.js) ─────────────────────────
PORT=3000
INGEST_TOKEN=shared-secret-the-trigger-ingest-function-sends
# Optional — carrier poll schedule (default every 15 min)
CHECK_CRON=*/15 * * * *
